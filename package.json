{
  "name": "bloom-electronic-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-static-pages.mjs && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/accessibility.test.mjs tests/analytics.test.mjs tests/lead.test.mjs tests/lead-api.test.mjs",
    "test:seo": "npm run build && node --test tests/routes-seo.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "npm test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^6.4.3"
  }
}
